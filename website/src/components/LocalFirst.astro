---
// Local first, then the final call to action and the footer, which the canvas draws inside the same section.
import BoardBg from "./BoardBg.astro";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { DOWNLOAD_URL, OS, REPO_URL } from "./os";

const mono = "font-size:13px";
---

<section class="sec">
  <div class="wrap">
    <div class="rv">
      <div class="label">Local first</div>
      <h2 class="h2">Your code stays on your machine.</h2>
    </div>
    <div class="priv rv">
      <div>
        <h3>Runs where you work</h3>
        <p>
          Otaq runs your own agent tools on your own computer, with your git, gh and az sign-ins. No Otaq
          account, no Otaq server.
        </p>
      </div>
      <div>
        <h3>Nothing added to your repo</h3>
        <p>
          Tickets live in a local database in{" "}
          <span class="mono" style={mono}>
            ~/.otaq
          </span>
          . Worktrees sit outside your repository. Nothing is pushed until you choose Open PR.
        </p>
      </div>
      <div>
        <h3>No traffic of its own</h3>
        <p>
          Apart from a daily check for new versions, Otaq sends nothing. The rest is what your agent tools,
          git, gh or az send. It’s MIT licensed, so you can read the code and check.
        </p>
      </div>
    </div>
    <div class="final rv">
      <BoardBg
        cards={[
          { top: 40, delay: -3, key: "NOTE-16" },
          { top: 150, delay: -11, key: "SHOP-40", bar: 60, needsYou: true },
          { top: 260, delay: -19, key: "NOTE-17", bar: 70 },
        ]}
      />
      <Mark size={60} />
      <h2>
        Hand off the tickets.
        <br />
        Keep the decisions.
      </h2>
      <p class="sub" style="margin:0 auto">
        Free, open source and MIT licensed.
      </p>
      <div class="cta">
        <a class="btn btn-p btn-lg" href={DOWNLOAD_URL}>
          <Icon icon="download" />
          <span data-os-download>{OS.mac.download}</span>
        </a>
        <a class="btn btn-s btn-lg" href={REPO_URL}>
          <Icon icon="git-branch" />
          View on GitHub
        </a>
      </div>
    </div>
    <footer class="foot">
      <span>© 2026 The Otaq Authors · MIT License</span>
      <nav aria-label="Footer">
        <a href={REPO_URL}>GitHub</a>
        <a href={`${REPO_URL}/releases`}>Releases</a>
        <a href={`${REPO_URL}/issues`}>Issues</a>
        <a href="#install">Install</a>
      </nav>
      <span style="flex-basis:100%">
        Claude Code, Codex, GitHub Copilot and OpenCode are trademarks of their owners. Otaq is an independent
        project and isn’t affiliated with them.
      </span>
    </footer>
  </div>
</section>
