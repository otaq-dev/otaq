---
// The dim board that moves behind the hero and the final call to action: lanes (hero only) and travelling cards.
// Its words are drawn from `data-label` by CSS (landing.css), not as text: they are decoration, deliberately dim,
// and as text they would fail the contrast check (WEB-06).
interface Props {
  lanes?: boolean;
  cards: { top: number; delay: number; key: string; bar?: number; needsYou?: boolean }[];
}
const { lanes = false, cards } = Astro.props;
const laneTitles = ["Backlog", "Ready for Dev", "Dev", "Review", "Approved", "Done"];
---

<div class="bgb" aria-hidden="true">
  {lanes && (
    <div class="lanes">
      {laneTitles.map((t) => (
        <div class="lane">
          <span data-label={t} />
        </div>
      ))}
    </div>
  )}
  <div class="trk">
    {cards.map((c) => (
      <div
        class:list={["bc", { n: c.needsYou }]}
        style={`top:${String(c.top)}px;animation-delay:${String(c.delay)}s`}
      >
        <i data-label={c.key} />
        <b style={c.bar === undefined ? undefined : `width:${String(c.bar)}%`} />
      </div>
    ))}
  </div>
</div>
