---
import Icon from "./Icon.astro";
---

<section class="sec" id="agents">
  <div class="wrap">
    <div class="rv">
      <div class="label">Meet the crew</div>
      <h2 class="h2">Give every ticket the right agent.</h2>
      <p class="sub">
        Name your agents, give each a tool and a model, and mix them on one board. Here’s a crew you might set
        up.
      </p>
    </div>
    <div class="crew">
      <div class="mate rv">
        <span class="av lg av-cc">CC</span>
        <span class="nm">Mira</span>
        <span class="tm">Claude Code · opus</span>
        <p>Hard features and tricky bugs.</p>
        <span class="st pill p-w">
          <Icon icon="loader" class="spin" />
          Working on SHOP-18
        </span>
      </div>
      <div class="mate rv">
        <span class="av lg av-cx">CX</span>
        <span class="nm">Theo</span>
        <span class="tm">Codex · gpt-5-codex</span>
        <p>Everyday tickets.</p>
        <span class="st pill p-w">
          <Icon icon="loader" class="spin" />
          Working on NOTE-8
        </span>
      </div>
      <div class="mate rv">
        <span class="av lg av-cc">CC</span>
        <span class="nm">Pip</span>
        <span class="tm">Claude Code · haiku</span>
        <p>Docs, typos and small config.</p>
        <span class="st pill p-d">
          <Icon icon="check" />
          Idle
        </span>
      </div>
      <div class="mate rv">
        <span class="av lg av-cp">CP</span>
        <span class="nm">Vera</span>
        <span class="tm">Copilot · gemini-2.5-pro</span>
        <p>Checks everyone’s work, on another company’s model.</p>
        <span class="st pill p-i">
          <Icon icon="shield-check" />
          Validating NOTE-10
        </span>
      </div>
      <div class="mate rv">
        <span class="av lg av-oc">OC</span>
        <span class="nm">Otto</span>
        <span class="tm">OpenCode · any model</span>
        <p>Whatever model you connect.</p>
        <span class="st pill p-d">
          <Icon icon="check" />
          Idle
        </span>
      </div>
    </div>
    <div class="crew-n rv">
      <span>
        <Icon icon="check" />
        Pick one per ticket, or let the defaults decide
      </span>
      <span>
        <Icon icon="check" />
        One tool hits its limit? Only its agents wait
      </span>
      <span>
        <Icon icon="check" />
        Your own sign-ins. Never your passwords or keys
      </span>
    </div>
  </div>
</section>
