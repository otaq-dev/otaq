---
import Base from "../layouts/Base.astro";

// A placeholder so the site builds: the nav's brand as drawn (Main.dc.html). T-0397 replaces this page.
---

<Base>
  <main id="top" class="lp">
    <a class="brand" href="#top" aria-label="Otaq home">
      <svg class="mk" width="26" height="26" viewBox="0 0 120 120" aria-hidden="true">
        <path class="o" d="M18 106 V70 Q42 60 60 30 Q78 60 102 70 V106 Z"></path>
        <path class="c" d="M46 62 V106 M74 62 V106"></path>
        <path class="c" d="M60 30 V4"></path>
        <path class="f" d="M60 4 H80 Q83 4 81 7 L77 12 L81 17 Q83 20 80 20 H60 Z"></path>
      </svg>
      Otaq
    </a>
  </main>
</Base>

<style>
  .lp {
    --flag: #14b8a6;
    min-height: 100vh;
    padding: 17px 32px;
    box-sizing: border-box;
    background: var(--bg-app);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 17px;
  }
  .brand:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .mk {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mk .o {
    stroke-width: 8;
  }
  .mk .c {
    stroke-width: 7;
  }
  .mk .f {
    fill: var(--flag);
    stroke: none;
    transform-origin: 60px 12px;
    animation: flag 2.4s ease-in-out infinite;
  }
  @keyframes flag {
    0%,
    100% {
      transform: skewY(0);
    }
    50% {
      transform: skewY(-6deg) scaleX(0.94);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mk .f {
      animation: none;
    }
  }
</style>
