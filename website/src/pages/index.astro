---
import "../styles/landing.css";
import Crew from "../components/Crew.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Icons from "../components/Icons.astro";
import Install from "../components/Install.astro";
import LiveDemo from "../components/LiveDemo.astro";
import LocalFirst from "../components/LocalFirst.astro";
import Nav from "../components/Nav.astro";
import WhatYouDo from "../components/WhatYouDo.astro";
import Base from "../layouts/Base.astro";

// The landing page, as drawn on the canvas (Main.dc.html), section by section (WEB-04).
---

<Base>
  <div class="lp">
    <Icons />
    <Nav />
    <main id="top">
      <Hero />
      <LiveDemo />
      <HowItWorks />
      <WhatYouDo />
      <Crew />
      <Install />
      <LocalFirst />
    </main>
  </div>
</Base>

<script>
  import { startCopyButtons } from "../components/copy";
  import { startOsPick } from "../components/osPick";

  startOsPick();
  startCopyButtons();
</script>
